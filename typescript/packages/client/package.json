{
  "name": "@arcadedb/client",
  "version": "0.1.0",
  "description": "TypeScript/JavaScript HTTP client for ArcadeDB, generated from ArcadeDB's OpenAPI contract.",
  "type": "module",
  "sideEffects": false,
  "license": "Apache-2.0",
  "keywords": [
    "arcadedb",
    "database",
    "graph-database",
    "multi-model",
    "http-client"
  ],
  "homepage": "https://github.com/ArcadeData/arcadedb-clients/tree/main/typescript/packages/client#readme",
  "bugs": {
    "url": "https://github.com/ArcadeData/arcadedb-clients/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ArcadeData/arcadedb-clients.git",
    "directory": "typescript/packages/client"
  },
  "engines": {
    "node": ">=20"
  },
  "arcadedb": {
    "serverVersion": "26.9.1-SNAPSHOT"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "prepack": "tsc --build"
  },
  "dependencies": {
    "openapi-fetch": "0.17.0"
  }
}
